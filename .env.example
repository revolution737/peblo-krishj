# Database
POSTGRES_USER=peblo
POSTGRES_PASSWORD=peblo_dev_password
POSTGRES_DB=peblo_tv
DATABASE_URL=postgresql+asyncpg://peblo:peblo_dev_password@postgres:5432/peblo_tv

# Auth
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/storage
# STORAGE_R2_ACCOUNT_ID=
# STORAGE_R2_ACCESS_KEY_ID=
# STORAGE_R2_SECRET_ACCESS_KEY=
# STORAGE_R2_BUCKET_NAME=

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Seeding
SEED_ON_STARTUP=true
DEFAULT_ADMIN_EMAIL=admin@peblo.tv
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_EDITOR_EMAIL=editor@peblo.tv
DEFAULT_EDITOR_PASSWORD=editor123
